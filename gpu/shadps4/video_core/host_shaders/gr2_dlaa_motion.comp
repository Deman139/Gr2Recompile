// Gravity Rush 2: DLSS motion vectors from the game's velocity target (docs: README_GR2.md,
// DLAA). The game stores previous - current position in NDC (y up); DLSS takes render pixels
// from the current pixel to its previous position (x right, y down).
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D velocity;
layout(binding = 1, rg16f) uniform writeonly image2D motion;

layout(push_constant) uniform Params {
    vec2 scale; // (width / 2, -height / 2)
    ivec2 size;
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 mv = texelFetch(velocity, pixel, 0).xy * scale;
    if (any(isnan(mv)) || any(isinf(mv))) {
        mv = vec2(0.0);
    }
    imageStore(motion, pixel, vec4(mv, 0.0, 0.0));
}
